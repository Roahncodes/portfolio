# ── React Bits Pro (component registry) ────────────────────────────────────────
# Required before `npx shadcn@latest add @reactbits-starter/<component>`.
# The shadcn CLI reads it through components.json:
#   "Authorization": "Bearer ${REACTBITS_LICENSE_KEY}"
# Find it at https://pro.reactbits.dev (Account → License key).
# Never paste this value into chat and never commit it — .env.local is gitignored.
REACTBITS_LICENSE_KEY=

# ── Spotify integration ────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values.
#
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Add this Redirect URI EXACTLY (Spotify does no trailing-slash normalisation):
#      http://127.0.0.1:3000/api/spotify/callback     (local development)
#      https://your-domain.com/api/spotify/callback   (production)
# 3. Visit /api/spotify/login while `npm run dev` is running. After you approve the
#    scopes the callback page prints the refresh token to paste below.
#
# The site works without these — the "Last song listened" card simply renders the
# NOT CONNECTED state.

SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REFRESH_TOKEN=your-spotify-refresh-token
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# ── Guestbook database ────────────────────────────────────────────────────────
# Reviews are stored in MongoDB Atlas; the free M0 cluster is enough.
# Create the cluster, a database user, and allow your app to connect
# (Network Access → 0.0.0.0/0 for a Vercel deployment), then paste the driver
# connection string here. The database and collection are created on the first
# review — no migration step. See REVIEWS.md for the full walkthrough.
MONGODB_URI=
# Optional: defaults to `portfolio`. Atlas creates it on first write.
MONGODB_DB=portfolio

# Optional: the public URL of the deployed site, used for canonical/OG metadata.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
